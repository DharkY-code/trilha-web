{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trilha-web",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dhark-library-db",
      "database_id": "1bc4d915-367c-4a41-be96-be33cc5f9c1d",
      "migrations_dir": "migrations"
    }
  ]
}
